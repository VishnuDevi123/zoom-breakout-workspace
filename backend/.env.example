# Copy to backend/.env and fill in. Render takes the same keys.
PORT=4000
NODE_ENV=development

# Zoom Marketplace app: client id and secret (the secret also decrypts the app context token),
# and the Secret Token from Features > Event subscriptions (signs webhooks).
ZOOM_CLIENT_ID=xxxxxxxx
ZOOM_CLIENT_SECRET=xxxxxxxx
ZOOM_WEBHOOK_SECRET=xxxxxxxx

# DynamoDB: an IAM user limited to the two tables.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
TEMPLATES_TABLE=breakout-templates
MEETINGS_TABLE=breakout-meeting

OPENAI_API_KEY=xxxxxxxx
